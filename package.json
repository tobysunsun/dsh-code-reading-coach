{
  "name": "dsh-code-reading-coach",
  "description": "代码研读教练（Code Reading Coach）— 交互式引导研读论文对应开源代码的 Agent 预设插件。五段研读法：锚定论文主张 → 地形扫描 → 入口追踪 → 核心映射 → 闭环验证。",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "lib",
    "preset",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "homepage": "https://github.com/tobysunsun/dsh-code-reading-coach",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "agent-preset",
    "code-reading",
    "paper"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobysunsun/dsh-code-reading-coach.git"
  },
  "bugs": {
    "url": "https://github.com/tobysunsun/dsh-code-reading-coach/issues"
  },
  "scripts": {
    "check": "node scripts/check.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    }
  }
}
